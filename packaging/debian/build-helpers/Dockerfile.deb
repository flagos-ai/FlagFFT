ARG BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu24.04
FROM ${BASE_IMAGE} AS builder

# Builds strictly against the base distribution's native system python3 and
# development packages with no external PPA or cross-distro binary downloads.
ARG DEB_VERSION_SUFFIX=auto
ARG PYTHON_VERSION=
ARG TORCH_INDEX=https://resource.flagos.net/repository/flagos-pypi-nvidia/simple
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils build-essential ca-certificates curl debhelper devscripts \
        dpkg-dev fakeroot git libfmt-dev libsqlite3-dev ninja-build \
        nlohmann-json3-dev patch python3 python3-dev python3-pip python3-venv \
    && pyver="$(/usr/bin/python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" \
    && if [ -n "${PYTHON_VERSION}" ] && [ "${PYTHON_VERSION}" != "${pyver}" ]; then \
        . /etc/os-release; \
        echo "ERROR: PYTHON_VERSION=${PYTHON_VERSION} conflicts with ${PRETTY_NAME:-distro} native Python ${pyver}" >&2; \
        exit 1; \
       fi \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir "cmake>=3.25,<4.0" "setuptools>=68" wheel

COPY packaging/debian/build-helpers/python-build-requirements.txt /tmp/flagfft-requirements.txt
RUN python3 -m pip install --no-cache-dir --index-url "${TORCH_INDEX}" -r /tmp/flagfft-requirements.txt \
    || python3 -m pip install --no-cache-dir \
        --index-url "${TORCH_INDEX}" \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        -r /tmp/flagfft-requirements.txt

COPY . /workspace/flagfft
WORKDIR /workspace/flagfft

RUN test -f deps/libtriton_jit/CMakeLists.txt || { \
        echo "ERROR: deps/libtriton_jit/CMakeLists.txt missing; run git submodule update --init --recursive"; \
        exit 1; \
    }

RUN cp -r packaging/debian debian && \
    if [ "${DEB_VERSION_SUFFIX}" = "auto" ]; then \
        . /etc/os-release && suffix="+${ID}${VERSION_ID}"; \
    else suffix="${DEB_VERSION_SUFFIX}"; fi && \
    if [ -n "${suffix}" ]; then \
        base="$(dpkg-parsechangelog -l debian/changelog -SVersion)" && \
        case "${base}" in *"${suffix}") ;; *) \
            clean_base="$(printf '%s' "${base}" | sed -E 's/\+[a-z]{3,}[0-9][a-z0-9.]*$//')" && \
            DEBFULLNAME="FlagOS Contributors" DEBEMAIL="contact@flagos.io" \
            dch -b -v "${clean_base}${suffix}" -D unstable --force-distribution \
                "Rebuild for $(. /etc/os-release && echo "${PRETTY_NAME}")." ;; \
        esac; \
    fi

RUN dpkg-buildpackage -us -uc -b -d || \
    { echo "Build failed, checking logs..."; \
      find /workspace -name "*.log" -exec echo "=== {} ===" \; -exec cat {} \; 2>/dev/null || true; \
      exit 1; }

RUN mkdir -p /output && \
    find /workspace -maxdepth 1 -name "*.deb" -exec cp {} /output/ \; && \
    ls -lh /output/

FROM scratch AS output
COPY --from=builder /output/*.deb /output/
